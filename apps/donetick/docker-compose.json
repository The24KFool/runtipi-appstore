{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "isMain": true,
      "image": "donetick/donetick:v0.1.74",
      "name": "donetick",
      "internalPort": 2021,
      "environment": [
        {
          "key": "DT_ENV",
          "value": "selfhosted"
        },
        {
          "key": "DT_SQLITE_PATH",
          "value": "/donetick-data/donetick.db"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/donetick/data",
          "containerPath": "/donetick-data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/donetick/configs",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "isMain": true,
      "image": "donetick/donetick:v0.1.74",
      "name": "donetick",
      "internalPort": 2021,
      "networks": [
        "tipi_main_network"
      ],
      "environment": [
        { "key": "DT_ENV", "value": "selfhosted" },
        { "key": "DT_SQLITE_PATH", "value": "/donetick-data/donetick.db" },
        { "key": "DT_NAME", "value": "donetick" },
        { "key": "DT_IS_DONE_TICK_DOT_COM", "value": "false" },
        { "key": "DT_IS_USER_CREATION_DISABLED", "value": "false" },
        { "key": "DT_DATABASE_TYPE", "value": "sqlite" },
        { "key": "DT_DATABASE_MIGRATION", "value": "true" },
        { "key": "DT_JWT_SECRET", "value": "${JWT_DONETICK_SECRET}" },
		{ "key": "DT_JWT_SESSION_TIME", "value": "168h" },
		{ "key": "DT_JWT_MAX_REFRESH", "value": "1440h" },
        { "key": "DT_SERVER_PORT", "value": "2021" },
		{ "key": "DT_SERVER_READ_TIMEOUT", "value": "2s" },
		{ "key": "DT_SERVER_WRITE_TIMEOUT", "value": "1s" },
		{ "key": "DT_SERVER_RATE_PERIOD", "value": "60s" },
		{ "key": "DT_SERVER_RATE_LIMIT", "value": "300" },
        { "key": "DT_SERVER_CORS_ALLOW_ORIGINS", "value": "http://localhost:5173,http://localhost:7926,https://localhost,capacitor://localhost" },
        { "key": "DT_SERVER_SERVE_FRONTEND", "value": "true" },
		{ "key": "DT_SCHEDULER_JOBS_DUE_JOB", "value": "30m" },
		{ "key": "DT_SCHEDULER_JOBS_OVERDUE_JOB", "value": "3h" },
		{ "key": "DT_SCHEDULER_JOBS_PRE_DUE_JOB", "value": "3h" }
		
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/donetick/data",
          "containerPath": "/donetick-data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/donetick/configs",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
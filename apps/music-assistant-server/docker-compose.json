{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "isMain": true,
      "image": "ghcr.io/music-assistant/server:2.6.3",
      "name": "music-assistant-server",
      "restart": "unless-stopped",
      "internalPort": 8095,
      "environment": {
        "LOG_LEVEL": "info"
      }
	  "networkMode": "host",
	  "cap_add": ["SYS_ADMIN", "DAC_READ_SEARCH"],
	  "securityOpt": ["apparmor:unconfined"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/music-assistant-server/data",
          "containerPath": "/data/"
        }	
      ]
    }
  ]
}
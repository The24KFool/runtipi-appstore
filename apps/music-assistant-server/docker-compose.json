{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "isMain": true,
      "image": "ghcr.io/music-assistant/server:latest",
      "name": "music-assistant-server",
      "restart": "unless-stopped"
      "internalPort": 2020,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/music-assistant-server/data",
          "containerPath": "/data/"
        }	
      ]
    }
  ]
}
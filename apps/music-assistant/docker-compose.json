{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "music-assistant",
      "image": "ghcr.io/music-assistant/server:2.6.3",
      "isMain": true,
      "internalPort": 8095,
      "exposedPorts": [8095, 8097],
      "environment": [
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/music-assistant/data",
          "containerPath": "/data/"
        }
      ],
      "restart": "unless-stopped"
    }
  ]
}

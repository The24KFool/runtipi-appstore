{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "music-assistant",
      "image": "ghcr.io/music-assistant/server:2.7.6",
      "isMain": true,
      "internalPort": 8095,
      "networkMode": "host",
      "environment": [
        {
          "key": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/music-assistant/data",
          "containerPath": "/data/"
        }
      ],
      "capAdd": ["SYS_ADMIN", "DAC_READ_SEARCH"],
      "securityOpt": ["apparmor:unconfined"]
    }
  ]
}

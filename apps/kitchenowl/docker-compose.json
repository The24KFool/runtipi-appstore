{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "isMain": true,
      "image": "tombursch/kitchenowl:v0.7.6",
      "name": "kitchenowl",
      "internalPort": 8080,
      "environment": {
        "JWT_SECRET_KEY": "${JWT_KITCHENOWL_SECRET}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/kitchenowl/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
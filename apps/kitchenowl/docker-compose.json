{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "isMain": true,
      "image": "tombursch/kitchenowl:v0.7.6",
      "name": "kitchenowl",
      "internalPort": 8210,
      "environment": [
        {
          "key": "JWT_SECRET_KEY",
          "value": "${JWT_KITCHENOWL_SECRET}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/kitchenowl/data",
          "containerPath": "/data"
        }	
      ]
    }
  ]
}
{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "frappe",
      "image": "frappe/bench:latest",
      "isMain": true,
      "internalPort": 8000,
      "dependsOn": [
        "frappe-db",
        "frappe-redis-cache",
        "frappe-redis-queue"
      ],
      "environment": {
        "SHELL": "/bin/bash"
      },
      "working_dir": "/home/frappe",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/workspace",
          "containerPath": "/workspace"
        },
        {
          "hostPath": "${APP_DATA_DIR}/frappe-bench",
          "containerPath": "/home/frappe/frappe-bench"
        }
      ],
      "command": [
        "bash",
        "/workspace/init.sh"
      ],
      "addPorts": [
        {
          "hostPort": 9000,
          "containerPort": 9000
        }
      ]
    },
    {
      "name": "frappe-db",
      "image": "mariadb:11.8.8",
      "restart": "always",
      "environment": {
        "MARIADB_ROOT_PASSWORD": "${MARIADB_ROOT_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/mariadb/var/lib/mysql",
          "containerPath": "/var/lib/mysql"
        }
      ],
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--skip-character-set-client-handshake"
      ]
    },  
    {
      "name": "frappe-redis-cache",
      "image": "redis:7"
    },
    {
      "name": "frappe-redis-queue",
      "image": "redis:7"
    }
  ]
}
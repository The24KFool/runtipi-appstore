{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "isMain": true,
      "image": "ghcr.io/ridafkih/keeper-services:latest",
      "name": "keeper",
      "internalPort": 3000,
      "environment": {
        "DATABASE_URL": "postgres://keeper:${KEEPER_DB_PASSWORD}@keeper-db:5432/keeper",
        "REDIS_URL": "redis://keeper-redis:6379",
        "WORKER_JOB_QUEUE_ENABLED": "true",
        "ENCRYPTION_KEY": "${KEEPER_ENCRYPTION_KEY}",
        "BETTER_AUTH_URL": "http://localhost:${APP_PORT}",
        "BETTER_AUTH_SECRET": "${KEEPER_AUTH_SECRET}",
        "MICROSOFT_CLIENT_ID": "${MICROSOFT_CLIENT_ID}",
        "MICROSOFT_CLIENT_SECRET": "${MICROSOFT_CLIENT_SECRET}"
      },
      "depends_on": [
        "keeper-db",
        "keeper-redis"
      ]
    },
    {
      "image": "postgres:17",
      "name": "keeper-db",
      "environment": {
        "POSTGRES_USER": "keeper",
        "POSTGRES_PASSWORD": "${KEEPER_DB_PASSWORD}",
        "POSTGRES_DB": "keeper"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "image": "redis:7",
      "name": "keeper-redis"
    }
  ]
}
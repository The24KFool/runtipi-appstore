{
  "name": "Continuwuity",
  "id": "continuwuity",
  "available": true,
  "short_desc": "A community-driven Matrix homeserver in Rust",
  "author": "continuwuity",
  "port": 8008,
  "categories": [
    "social"
  ],
  "description": "A community-driven Matrix homeserver in Rust",
  "tipi_version": 5,
  "version": "latest",
  "source": "https://github.com/continuwuity/continuwuity",

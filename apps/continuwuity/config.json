    },
    {
      "type": "random",
      "min": 20,
      "max": 20,
      "label": "LiveKit Matrix Key",
      "env_variable": "LK_MATRIX_KEY"
    },
    {
      "type": "random",
      "min": 64,
      "max": 64,
      "label": "LiveKit Matrix Secret",
      "env_variable": "LK_MATRIX_SECRET"
    }
  ],
  "exposable": true,
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
  "dynamic_config": true

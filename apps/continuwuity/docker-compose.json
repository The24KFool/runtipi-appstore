{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "continuwuity",
      "image": "ghcr.io/continuwuity/continuwuity:latest",
      "isMain": true,
	  "restart": "always",
      "internalPort": 8008,
      "dependsOn": ["continuwuity-livekit-jwt", "continuwuity-livekit", "continuwuity-coturn"],
      "environment": {
        "CONTINUWUITY_SERVER_NAME": "${HOMESERVER}",
        "CONTINUWUITY_DATABASE_PATH": "/var/lib/continuwuity",
		"CONTINUWUITY_CONFIG": "/etc/continuwuity/continuwuity.toml",
        "CONTINUWUITY_ADDRESS": "0.0.0.0"
      },
      "volumes": [
		{
          "hostPath": "${APP_DATA_DIR}/continuwuity/var/lib/continuwuity",
          "containerPath": "/var/lib/continuwuity"
        },
		{
          "hostPath": "${APP_DATA_DIR}/continuwuity/etc/continuwuity/continuwuity.toml",
          "containerPath": "/etc/continuwuity/continuwuity.toml"
        }
      ]
    },
    {
      "name": "continuwuity-livekit-jwt",
      "image": "ghcr.io/element-hq/lk-jwt-service:latest",
	  "restart": "unless-stopped",
      "environment": {
        "LIVEKIT_JWT_BIND": ":8081",
        "LIVEKIT_URL": "wss://matrix-rtc.${HOMESERVER}",
        "LIVEKIT_FULL_ACCESS_HOMESERVERS": "${HOMESERVER}",
        "LIVEKIT_KEY": "${LK_MATRIX_KEY}",
        "LIVEKIT_SECRET": "${LK_MATRIX_SECRET}"
      },
      "addPorts": [
        {
          "hostPort": 8081,
          "containerPort": 8081
        }
      ]
    },
    {
      "name": "continuwuity-livekit",
      "image": "livekit/livekit-server:latest",
	  "command": ["--config", "/etc/livekit.yaml"],
	  "restart": "unless-stopped",
	  "networkMode": "host",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/livekit/etc/livekit.yaml",
          "containerPath": "/etc/livekit.yaml"
        }
      ]
    },
    {
      "name": "continuwuity-coturn",
      "image": "docker.io/coturn/coturn",
	  "restart": "unless-stopped",
	  "networkMode": "host",
	  "command": ["--min-port=49160", "--max-port=49200"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/coturn/turnserver.conf",
          "containerPath": "/etc/coturn/turnserver.conf"
        }
      ]
    }
  ]
}

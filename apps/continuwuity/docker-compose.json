{
  "$schema": "../dynamic-compose-schema.json",
  "services": [
    {
      "name": "continuwuity",
      "image": "ghcr.io/continuwuity/continuwuity:latest",
      "isMain": true,
      "restart": "always",
      "internalPort": 8008,
      "dependsOn": ["continuwuity-livekit-jwt", "continuwuity-livekit", "continuwuity-coturn"],
      "environment": [
        { "key": "CONTINUWUITY_SERVER_NAME", "value": "${HOMESERVER}" },
        { "key": "CONTINUWUITY_DATABASE_PATH", "value": "/var/lib/continuwuity" },
        { "key": "CONTINUWUITY_ADDRESS", "value": "0.0.0.0" },
        { "key": "CONTINUWUITY_ALLOW_FEDERATION", "value": "false" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/var/lib/continuwuity",
          "containerPath": "/var/lib/continuwuity"
        }
      ]
    },
    {
      "name": "continuwuity-livekit-jwt",
      "image": "ghcr.io/element-hq/lk-jwt-service:latest",
      "restart": "unless-stopped",
      "environment": [
        { "key": "LIVEKIT_JWT_BIND", "value": ":8081" },
        { "key": "LIVEKIT_URL", "value": "wss://livekit.${HOMESERVER}" },
        { "key": "LIVEKIT_FULL_ACCESS_HOMESERVERS", "value": "${HOMESERVER}" },
        { "key": "LIVEKIT_KEY", "value": "${LK_MATRIX_KEY}" },
        { "key": "LIVEKIT_SECRET", "value": "${LK_MATRIX_SECRET}" }
      ],
      "addPorts": [
        {
          "hostPort": 8081,
          "containerPort": 8081,
          "protocol": "tcp"
        }
      ]
    },
    {
      "name": "continuwuity-livekit",
      "image": "livekit/livekit-server:latest",
      "command": ["--config", "/etc/livekit.yaml"],
      "restart": "unless-stopped",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/livekit/etc/livekit.yaml",
          "containerPath": "/etc/livekit.yaml",
          "readOnly": true
        }
      ],
      "addPorts": [
        { "hostPort": 7880, "containerPort": 7880, "protocol": "tcp" },
        { "hostPort": 7881, "containerPort": 7881, "protocol": "tcp" }
      ]
    },
    {
      "name": "continuwuity-coturn",
      "image": "docker.io/coturn/coturn",
      "restart": "unless-stopped",
      "environment": [
        { "key": "DETECT_EXTERNAL_IP", "value": "yes" },
        { "key": "DETECT_RELAY_IP", "value": "yes" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/coturn/turnserver.conf",
          "containerPath": "/etc/coturn/turnserver.conf",
          "readOnly": true
        }
      ],
      "addPorts": [
        { "hostPort": 3478, "containerPort": 3478, "protocol": "tcp" },
        { "hostPort": 5349, "containerPort": 5349, "protocol": "tcp" }
      ]
    }
  ]
}
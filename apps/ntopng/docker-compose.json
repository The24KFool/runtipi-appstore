{
  "schemaVersion": 2,
  "services": [
    {
      "name": "ntopng",
      "image": "ntop/ntopng:stable",
      "container_name": "ntopng",
      "restart": "unless-stopped",
      "command": [
        "--community",
        "-i", "collector:2055",
        "-i", "collector:2056",
        "-i", "collector:2057",
        "-i", "collector:2058",
        "-i", "collector:2059",
        "-w", "3000"
      ],
      "ports": [
        { "hostPort": 2055, "containerPort": 2055, "protocol": "udp" },
        { "hostPort": 2056, "containerPort": 2056, "protocol": "udp" },
        { "hostPort": 2057, "containerPort": 2057, "protocol": "udp" },
        { "hostPort": 2058, "containerPort": 2058, "protocol": "udp" },
        { "hostPort": 2059, "containerPort": 2059, "protocol": "udp" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/ntopng",
          "containerPath": "/var/lib/ntopng"
        }
      ],
      "x-runtipi": {
        "is_main": true,
        "internal_port": 3000,
        "schema_version": 2
      }
    }
  ]
}
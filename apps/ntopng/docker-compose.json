{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "isMain": true,
      "image": "ntop/ntopng:stable",
      "name": "ntopng",
      "internalPort": 3000,
      "command": [
        "--community",
        "-i", "collector:2055",
        "-i", "collector:2056",
        "-i", "collector:2057",
        "-i", "collector:2058",
        "-i", "collector:2059",
        "-w", "3000"
      ],
      "addPorts": [
        { "containerPort": 2055, "hostPort": 2055, "udp": true },
        { "containerPort": 2056, "hostPort": 2056, "udp": true },
        { "containerPort": 2057, "hostPort": 2057, "udp": true },
        { "containerPort": 2058, "hostPort": 2058, "udp": true },
        { "containerPort": 2059, "hostPort": 2059, "udp": true }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/ntopng",
          "containerPath": "/var/lib/ntopng"
        }
      ]
    }
  ]
}
{
  "$schema": "../dynamic-compose-schema.json",
  "schemaVersion": 2,
  "services": [
    {
      "name": "akvorado",
      "isMain": true,
      "internalPort": 8080,
      "image": "quay.io/akvorado/akvorado:2.4.0",
      "restart": "unless-stopped",
      "dependsOn": [
        "akvorado-clickhouse",
        "akvorado-kafka",
        "akvorado-geoip",
        "akvorado-redis"
      ],
      "ports": [
        { 
          "hostPort": 2055, 
          "containerPort": 2055, 
          "protocol": "udp" 
        }
      ],
      "command": [
        "daemon",
        "/config/akvorado.yaml"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/geoip",
          "containerPath": "/usr/share/GeoIP"
        }
      ]
    },
    {
      "name": "akvorado-geoip",
      "image": "maxmindinc/geoipupdate:v7.1",
      "restart": "unless-stopped",
      "environment": [
        { "key": "GEOIPUPDATE_ACCOUNT_ID", "value": "${MAXMIND_ACCOUNT_ID}" },
        { "key": "GEOIPUPDATE_LICENSE_KEY", "value": "${MAXMIND_LICENSE_KEY}" },
        { "key": "GEOIPUPDATE_EDITION_IDS", "value": "GeoLite2-ASN GeoLite2-Country GeoLite2-City" },
        { "key": "GEOIPUPDATE_FREQUENCY", "value": "48" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/geoip",
          "containerPath": "/usr/share/GeoIP"
        }
      ]
    },
    {
      "name": "akvorado-kafka",
      "image": "apache/kafka-native:4.2.1",
      "restart": "unless-stopped",
      "environment": [
        { "key": "KAFKA_NODE_ID", "value": "1" },
        { "key": "KAFKA_PROCESS_ROLES", "value": "broker,controller" },
        { "key": "KAFKA_LISTENERS", "value": "CLIENT://:9092,CONTROLLER://:9093" },
        { "key": "KAFKA_ADVERTISED_LISTENERS", "value": "CLIENT://akvorado-kafka:9092" },
        { "key": "KAFKA_CONTROLLER_LISTENER_NAMES", "value": "CONTROLLER" },
        { "key": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP", "value": "CONTROLLER:PLAINTEXT,CLIENT:PLAINTEXT" },
        { "key": "KAFKA_INTER_BROKER_LISTENER_NAME", "value": "CLIENT" },
        { "key": "KAFKA_CONTROLLER_QUORUM_VOTERS", "value": "1@localhost:9093" },
        { "key": "KAFKA_LOG_DIRS", "value": "/var/lib/kafka/data" },
        { "key": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR", "value": "1" },
        { "key": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR", "value": "1" },
        { "key": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR", "value": "1" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/kafka",
          "containerPath": "/var/lib/kafka/data"
        }
      ]
    },
    {
      "name": "akvorado-clickhouse",
      "image": "clickhouse/clickhouse-server:26.3.12.3",
      "restart": "unless-stopped",
      "environment": [
        { "key": "CLICKHOUSE_USER", "value": "akvorado" },
        { "key": "CLICKHOUSE_PASSWORD", "value": "${CLICKHOUSE_PASSWORD}" },
        { "key": "CLICKHOUSE_DB", "value": "akvorado" },
        { "key": "CLICKHOUSE_INIT_TIMEOUT", "value": "60" },
        { "key": "CLICKHOUSE_SKIP_USER_SETUP", "value": "1" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/clickhouse/data",
          "containerPath": "/var/lib/clickhouse"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/clickhouse/log",
          "containerPath": "/var/log/clickhouse-server"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/clickhouse/akvorado.xml",
          "containerPath": "/etc/clickhouse-server/config.d/akvorado.xml"
        }
      ]
    },
    {
      "name": "akvorado-redis",
      "image": "redis:7",
      "restart": "unless-stopped",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/akvorado/redis",
          "containerPath": "/data"
        }
      ]
    }
  ]
}